# Public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key

# Used by Cloudflare Pages Functions (functions/api/*) - never exposed
# to the browser, only readable server-side inside the Functions runtime.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GITHUB_OWNER=your-github-username
GITHUB_REPO=review-monitor
GITHUB_ACTIONS_TOKEN=ghp_your_repo_scoped_token
